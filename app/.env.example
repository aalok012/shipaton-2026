# Copy this file to .env. Use the LAN address printed by backend/start.sh.
# Both devices must be on the same Wi-Fi. Restart Expo after changing this.
EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_LAN_IP:8000

# Optional separate API address for browser development on this laptop.
EXPO_PUBLIC_WEB_API_URL=http://localhost:8000
